# Copie para .env e preencha. NUNCA versione o .env.

# --- Neo4j ---
# Docker: o compose já aponta a API para o contêiner "neo4j"; defina só a senha local.
NEO4J_LOCAL_PASSWORD=troque-esta-senha
# Execução fora do Docker (uvicorn local / Aura):
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=troque-esta-senha
NEO4J_DATABASE=neo4j

# --- Autenticação (JWT) ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
# Duração do login em horas (padrão 12).
JWT_EXPIRE_HOURS=12

# --- E-mail (recuperação de senha e formulário de contato) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
SUPPORT_EMAIL=

# --- Confirmação de e-mail no cadastro ---
# true: a conta só entra depois de clicar no link enviado por e-mail (precisa de MAIL_*).
# false: a conta nasce confirmada (útil sem servidor de e-mail).
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFY_HOURS=24
# true: não envia e-mail; escreve o link de confirmação no log do servidor (testes/demonstração).
MAIL_SUPPRESS_SEND=false

# --- URLs ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# --- Imagens (quadro investigativo, fotos de suspeitos e fotos de perfil) ---
# Deixe SUPABASE_* vazio para guardar em disco (volume Docker, 100% local).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BOARD_BUCKET=quadro-investigativo
SUPABASE_SUSPECT_BUCKET=suspect-photos
SUPABASE_USER_BUCKET=user-photos
